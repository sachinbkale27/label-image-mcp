{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sachinbkale27/label-image-mcp",
  "title": "Histopathology Annotation MCP",
  "description": "Annotate histopathology images: StarDist nuclei, SAM/MedSAM outlines, QC, COCO/YOLO/QuPath export.",
  "version": "0.3.1",
  "websiteUrl": "https://labels.sachin-kale.com/mcp",
  "repository": {
    "url": "https://github.com/sachinbkale27/label-image-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "label-image-mcp",
      "version": "0.3.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LABEL_USERNAME",
          "description": "Image Label account username (needed to save annotations and upload)",
          "isRequired": false
        },
        {
          "name": "LABEL_PASSWORD",
          "description": "Image Label account password",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "LABEL_API_URL",
          "description": "API base URL",
          "isRequired": false,
          "default": "https://labels.sachin-kale.com/api"
        }
      ]
    }
  ]
}
